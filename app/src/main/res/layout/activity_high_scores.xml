<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_menu_gradient"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="32dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="HIGH SCORES"
        android:textColor="#F0E6D2"
        android:textSize="30sp"
        android:textStyle="bold"
        android:letterSpacing="0.05"
        android:gravity="center" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:orientation="vertical"
        android:background="@drawable/bg_button_secondary"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="BEST WAVE REACHED"
            android:textColor="#B8AACC"
            android:textSize="14sp"
            android:letterSpacing="0.05"
            android:gravity="center" />

        <TextView
            android:id="@+id/bestWaveText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="24dp"
            android:text="0"
            android:textColor="#F0E6D2"
            android:textSize="40sp"
            android:textStyle="bold"
            android:gravity="center" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="MOST KILLS IN A RUN"
            android:textColor="#B8AACC"
            android:textSize="14sp"
            android:letterSpacing="0.05"
            android:gravity="center" />

        <TextView
            android:id="@+id/bestKillsText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="0"
            android:textColor="#F0E6D2"
            android:textSize="40sp"
            android:textStyle="bold"
            android:gravity="center" />

    </LinearLayout>

    <Button
        android:id="@+id/backButton"
        android:layout_width="220dp"
        android:layout_height="56dp"
        android:layout_marginTop="40dp"
        android:background="@drawable/bg_button_primary"
        android:text="BACK"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold"
        android:elevation="4dp" />

</LinearLayout>
