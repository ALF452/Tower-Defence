<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_menu_gradient">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ARMORY"
            android:textColor="#F0E6D2"
            android:textSize="30sp"
            android:textStyle="bold"
            android:letterSpacing="0.05"
            android:gravity="center" />

        <TextView
            android:id="@+id/starDustText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Star Dust: 0"
            android:textColor="#39FF14"
            android:textSize="16sp"
            android:textStyle="bold"
            android:gravity="center" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Spend Star Dust earned from runs on permanent head starts for every future run."
            android:textColor="#8C7FA0"
            android:textSize="12sp"
            android:gravity="center" />

        <!-- Starting Gold row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_button_secondary"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="STARTING GOLD"
                    android:textColor="#F0E6D2"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/startingGoldLevelText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Level 0 / 5"
                    android:textColor="#B8AACC"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/startingGoldCostText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Cost: 60"
                    android:textColor="#39FF14"
                    android:textSize="12sp" />

            </LinearLayout>

            <Button
                android:id="@+id/startingGoldBuyButton"
                android:layout_width="90dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_button_primary"
                android:text="@string/armory_buy"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Wall Head Start row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_button_secondary"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="WALL HEAD START"
                    android:textColor="#F0E6D2"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/wallLevelText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Level 0 / 3"
                    android:textColor="#B8AACC"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/wallCostText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Cost: 140"
                    android:textColor="#39FF14"
                    android:textSize="12sp" />

            </LinearLayout>

            <Button
                android:id="@+id/wallBuyButton"
                android:layout_width="90dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_button_primary"
                android:text="@string/armory_buy"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Cannon Head Start row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_button_secondary"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CANNON HEAD START"
                    android:textColor="#F0E6D2"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/cannonLevelText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Level 0 / 3"
                    android:textColor="#B8AACC"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/cannonCostText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Cost: 150"
                    android:textColor="#39FF14"
                    android:textSize="12sp" />

            </LinearLayout>

            <Button
                android:id="@+id/cannonBuyButton"
                android:layout_width="90dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_button_primary"
                android:text="@string/armory_buy"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Archer Head Start row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_button_secondary"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ARCHER HEAD START"
                    android:textColor="#F0E6D2"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/archerLevelText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Level 0 / 3"
                    android:textColor="#B8AACC"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/archerCostText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Cost: 120"
                    android:textColor="#39FF14"
                    android:textSize="12sp" />

            </LinearLayout>

            <Button
                android:id="@+id/archerBuyButton"
                android:layout_width="90dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_button_primary"
                android:text="@string/armory_buy"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

        </LinearLayout>

        <Button
            android:id="@+id/backButton"
            android:layout_width="220dp"
            android:layout_height="56dp"
            android:layout_marginTop="28dp"
            android:background="@drawable/bg_button_primary"
            android:text="BACK"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:elevation="4dp" />

    </LinearLayout>

    </ScrollView>

</FrameLayout>
